# Copy this file to .env on the server.
DOMAIN=hub.example.com

APP_NAME=Knowledge Hub
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Use a long random string in production.
SECRET_KEY=change-this-to-a-long-random-secret

# Model API is strongly recommended for useful RAG on a free VM.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENAI_MODEL=glm-4-flash
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=2048
EMBEDDING_LOCAL_ENABLED=false

STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=knowledge-hub-files

# Free-tier defaults: text PDFs work; scanned PDFs/images need OCR before upload.
OCR_MODE=off
LAYOUT_ANALYSIS_ENABLED=false
TABLE_STRUCTURED_EXTRACTION=false
IMAGE_EXTRACTION_ENABLED=false

# Replace with your real domain after DNS is ready.
CORS_ORIGINS=["https://hub.example.com"]
