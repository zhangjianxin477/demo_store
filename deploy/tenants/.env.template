APP_NAME="Knowledge Hub"
APP_VERSION="1.0.0"
APP_ENV=production
DEBUG=false

HOST=0.0.0.0
PORT=8080

TENANT_ID={{TENANT_ID}}

OPENAI_API_KEY={{OPENAI_API_KEY}}
OPENAI_BASE_URL={{OPENAI_BASE_URL}}
OPENAI_MODEL={{OPENAI_MODEL}}
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
EMBEDDING_MODEL={{EMBEDDING_MODEL}}
EMBEDDING_DIMENSION=2048

CHUNK_SIZE=512
CHUNK_OVERLAP=64

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
HYBRID_SEARCH_WEIGHT_VECTOR=0.6
HYBRID_SEARCH_WEIGHT_KEYWORD=0.4

LOG_LEVEL=WARNING
CORS_ORIGINS=["https://{{TENANT_ID}}.yourdomain.com"]

# 生产环境必须修改 SECRET_KEY（使用 openssl rand -hex 32 生成）
SECRET_KEY=knowledge-hub-secret-key-change-in-production

STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=knowledge-hub-files
