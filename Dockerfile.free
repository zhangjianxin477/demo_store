FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-lite.txt .
RUN pip install --no-cache-dir -r requirements-lite.txt

COPY backend/ ./backend/
COPY frontend/ ./frontend/
COPY .env.example ./.env

RUN mkdir -p /app/data/uploads /app/data/vector_store /app/data/knowledge_base

ENV APP_ENV=production
ENV DEBUG=false
ENV HOST=0.0.0.0
ENV PORT=8080
ENV DATA_DIR=/app/data
ENV STORAGE_MODE=local
ENV EMBEDDING_LOCAL_ENABLED=false
ENV OCR_MODE=off
ENV LAYOUT_ANALYSIS_ENABLED=false
ENV TABLE_STRUCTURED_EXTRACTION=false
ENV IMAGE_EXTRACTION_ENABLED=false
ENV LOG_LEVEL=WARNING
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
