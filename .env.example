APP_NAME="Knowledge Hub"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8080

OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENAI_MODEL=glm-4-flash
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_DIMENSION=1024
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_DIMENSION=2560
EMBEDDING_LOCAL_ENABLED=true

CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_MIN_SIZE=120
CHILD_CHUNK_MAX_SIZE=450
CHILD_CHUNK_OVERLAP=50

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RETRIEVAL_MIN_K=30
RAG_RETRIEVAL_MULTIPLIER=8
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_AUTO_LLM_ENABLED=false
QUERY_EXPANSION_ENABLED=true
QUERY_REWRITE_MIN_OVERLAP=0.25
HYBRID_SEARCH_WEIGHT_VECTOR=0.6
HYBRID_SEARCH_WEIGHT_KEYWORD=0.4

CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=40
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=12
CONVERSATION_SUMMARY_BATCH_MESSAGES=20
CONVERSATION_SUMMARY_MAX_CHARS=1600

LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
ACCESS_CONTROL_ENABLED=true

STORAGE_MODE=local
VECTOR_BACKEND=local
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=knowledge_hub_chunks
MILVUS_METRIC_TYPE=COSINE
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=knowledge-hub-files

OCR_MODE=off
LAYOUT_ANALYSIS_ENABLED=true
TABLE_STRUCTURED_EXTRACTION=true
IMAGE_EXTRACTION_ENABLED=true

# WeChat Official Account sync (server-side only)
WECHAT_MCP_ENABLED=false

# 被动信息输入（Skill 定时日报）
PASSIVE_INGEST_ENABLED=true
PASSIVE_WEEKLY_REVIEW_ENABLED=true
PASSIVE_WEEKLY_REVIEW_CRON=0 8 * * 1
PASSIVE_WEEKLY_REVIEW_LOOKBACK_DAYS=7
PASSIVE_WEEKLY_REVIEW_MAX_FILES=30
# Optional comma-separated recipients; empty uses the configured email sender.
PASSIVE_WEEKLY_REVIEW_RECIPIENTS=
# Optional durable SMTP Secrets for cloud deployments with ephemeral disks.
# QQ Mail: use the authorization code, not the web-login password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
# QQ 邮箱示例：smtp.qq.com / 465 / use_ssl=true；密码使用邮箱授权码
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_DEFAULT_COVER_MEDIA_ID=
